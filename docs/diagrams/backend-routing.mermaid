flowchart TD
    A["Tool call"] --> K{"OpenRouter key set?"}
    K -->|no| G0["GeminiClient<br/>author/model ids refused with a fix"]
    K -->|yes| M{"model="}
    M -->|omitted| OR["OpenRouter<br/>openrouter.default_model or live free default"]
    M -->|"author/model"| OR
    M -->|"flash / flash-lite / pro / gemini-*"| GQ{"Gemini configured?"}
    GQ -->|yes| GM["Gemini<br/>file + web tools as configured"]
    GQ -->|no| ORG["OpenRouter as google/&lt;id&gt;"]
    G0 --> GPF
    GM --> GPF["preflight: API-key auth asks once that Google<br/>may use prompts; can't ask → not sent"]
    OR --> PF["preflight: price + privacy question on first use,<br/>then repository question if tools would go"]
    ORG --> PF
    PF --> ASK["chat: file tools if the model supports tool calling<br/>and you allowed repository access,<br/>else conversation only; no web"]
