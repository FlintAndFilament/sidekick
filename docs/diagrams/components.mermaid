graph TD
    ENV["plugin env<br/>SIDEKICK_OPENROUTER_KEY / SIDEKICK_API_KEY / SIDEKICK_SA_FILE"] -->|"plugin_option()"| CFG
    M["__main__.py"] --> CFG["load_config()<br/>config.py"]
    M --> AUTH["build_auth()<br/>auth.py"]
    M --> CL["GeminiClient(config, credentials, api_key)<br/>+ refresh_latest()<br/>client.py"]
    M --> BK["backends.py<br/>Backend / ModelSource / Surface"]
    M --> ROUTER["router.py Router<br/>only when an OpenRouter key is set"]
    ROUTER --> CL
    ROUTER --> ORC["openrouter.py OpenRouterClient"]
    ORC --> CAT["openrouter_catalog.py<br/>live prices, privacy, free default"]
    CL -.-> BK
    ORC -.-> BK
    M --> ROOT["project_root()<br/>workspace.py"]
    ROOT --> TR["TranscriptWriter(dir, startup, base=root)<br/>transcript.py"]
    ROOT --> WS["build_workspace(config, root)<br/>workspace.py"]
    M --> SRV["build_server(client, transcript, workspace)<br/>server.py"]
    M -. "any startup failure" .-> SETUP["build_setup_server(problem)<br/>server.py: setup_status only"]

    CFG --> JSON["~/.config/sidekick/config.json<br/>optional with the plugin key"]
    ENV --> AUTH
    AUTH --> CRED["google.auth Credentials<br/>or API key"]

    WS --> SB["Sandbox<br/>sandbox.py"]
    WS --> FT["FileTools + ToolRegistry<br/>file_tools.py"]
    WS --> AR["ArtifactStore<br/>artifacts.py"]

    SRV --> GUIDE["guide.py<br/>server_instructions() / help_text()"]
    SRV --> MCP["FastMCP + 8 registered tools"]
    MCP --> T1["ask"]
    MCP --> T2["brainstorm"]
    MCP --> T3["review"]
    MCP --> T4["debug"]
    MCP --> T5["architect"]
    MCP --> T6["list_models"]
    MCP --> T7["help"]
    MCP --> T8["list_sessions"]
    SRV -- "render callable" --> T7

    T1 & T2 & T3 & T4 & T5 --> BASE["tools/base.py<br/>call_gemini()"]
    GUIDE --> CAPS["tools CAPABILITIES<br/>+ tools/base hints"]
    BASE --> ROUTER
    BASE --> CL
    BASE --> ORC
    BASE --> WEB["web_tools.py<br/>resolve_capabilities()"]
    BASE --> SRC["sources.py<br/>resolve_redirects() + sources_footer()"]
    BASE --> TR
    BASE --> WS
    CL --> LOOP["tool_loop.py<br/>run_tool_loop()"]
    CL --> WEB
    T6 --> CL
    T6 & BASE & CL --> MOD["models.py<br/>shortlist / schema_hint / is_chat_capable"]
    T8 --> CL
